{
  "name": "sprat",
  "version": "0.1.0",
  "private": true,
  "description": "Sprat / Nerts: real-time multiplayer solitaire engine with attention-modelled bots",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "node --experimental-strip-types src/sim/cli.ts",
    "server": "node --experimental-strip-types src/server/server.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/ws": "^8.5.13",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
